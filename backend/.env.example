# Local PostgreSQL connection
DATABASE_URL=postgresql://localhost:5432/budget

# There is no authentication. Every row is attributed to this single user id.
# Must match the user_id on existing rows or that data will be invisible.
LOCAL_USER_ID=00000000-0000-0000-0000-000000000000
LOCAL_USER_EMAIL=local@localhost

# OpenAI API Key for the AI Financial Advisor feature
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
